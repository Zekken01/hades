<rml>
<head>
	<title>toast</title>
	<link type="text/rcss" href="dew://lib/html.rcss"/>
	<style>
		body {
			pointer-events: none;
		}

		#toast_container {
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-start;
			padding-top: 40dp;
			pointer-events: none;
		}

		.toast {
			display: flex;
			flex-direction: column;
			justify-content: center;
			overflow: hidden;
			min-width: 200dp;
			border-radius: 4dp;
			background-color: #061324e6;
			padding: 15dp 40dp 15dp 15dp;
			margin-bottom: 10dp;
			transform: translateX(-200%);
			transition: transform 0.3s cubic-in-out;
			position: relative;
		}

		.toast.toast-show {
			transform: translateX(0px);
		}

		/* the blue bar that collapses to the right edge (.toast:after) */
		.toast-bar {
			position: absolute;
			right: 0;
			top: 0;
			bottom: 0;
			width: 100%;
			background-color: #449ed133;
		}

		.toast-show .toast-bar {
			animation: 0.42s 0.15s cubic-in-out toastIn;
		}

		.toast-content {
			opacity: 0;
			color: #cfcfcf;
		}

		.toast-show .toast-content {
			animation: 0.32s 0.5s quadratic-in toastContentIn;
		}

		@keyframes toastIn {
			0%   { width: 100%; }
			50%  { width: 100%; }
			100% { width: 10dp; }
		}

		@keyframes toastContentIn {
			0%   { opacity: 0; }
			100% { opacity: 1; }
		}
	</style>
	<script>
		local active = 0

		local function finish(element)
			-- animations end on their last keyframe but do not persist; pin the end state
			local bar = element:QuerySelector(".toast-bar")
			if bar then bar.style.width = "10dp" end
			local content = element:QuerySelector(".toast-content")
			if content then content.style.opacity = "1" end
		end

		local function show(toast)
			local container = document:GetElementById("toast_container")
			local first = container.first_child
			local created = document:CreateElement("div")
			-- the newest toast goes on top, as prepend() did
			local added = first and container:InsertBefore(created, first) or container:AppendChild(created)
			added:SetClass("toast", true)
			added.inner_rml = '<div class="toast-bar"></div><div class="toast-content">' .. tostring(toast.body or "") .. '</div>'

			active = active + 1
			dew_core.setToastActive(true)

			dew.requestAnimationFrame(function()
				added:SetClass("toast-show", true)
			end)
			dew.setTimeout(function() finish(added) end, 820)
			dew.setTimeout(function()
				added:SetClass("toast-show", false)
				dew.setTimeout(function()
					container:RemoveChild(added)
					active = active - 1
					if active <= 0 then
						active = 0
						dew_core.setToastActive(false)
					end
				end, 3000)
			end, 3000)
		end

		dew.on("toast", function(message)
			show(message.data or {})
		end)
	</script>
</head>
<body>
	<div id="toast_container"></div>
</body>
</rml>

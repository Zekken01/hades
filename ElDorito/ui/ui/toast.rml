<rml>
<head>
	<title>toast</title>
	<link type="text/rcss" href="dew://lib/html.rcss"/>
	<style>
		body {
			pointer-events: none;
		}

		#toast_container {
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-start;
			padding-top: 40px;
			pointer-events: none;
		}

		.toast {
			display: flex;
			flex-direction: column;
			justify-content: center;
			overflow: hidden;
			min-width: 200px;
			border-radius: 4px;
			background-color: #061324e6;
			padding: 15px 40px 15px 15px;
			margin-bottom: 10px;
			transform: translateX(-200%);
			transition: transform 0.3s cubic-in-out;
			position: relative;
		}

		.toast.toast-show {
			transform: translateX(0px);
		}

		/* the blue bar that collapses to the right edge (.toast:after) */
		.toast-bar {
			position: absolute;
			right: 0;
			top: 0;
			bottom: 0;
			width: 100%;
			background-color: #449ed133;
		}

		/* .toast-show:after's toastIn animation: the bar collapses to the right edge.
		   Transitions (declared only while shown) keep the end state, as fill-mode did. */
		.toast-show .toast-bar {
			width: 10px;
			transition: width 0.42s 0.15s cubic-in-out;
		}

		.toast-content {
			opacity: 0;
			color: #cfcfcf;
		}

		.toast-show .toast-content {
			opacity: 1;
			transition: opacity 0.32s 0.5s quadratic-in;
		}
	</style>
	<script>
		local active = 0

		local function show(toast)
			local container = document:GetElementById("toast_container")
			local first = container.first_child
			local created = document:CreateElement("div")
			-- the newest toast goes on top, as prepend() did
			local added = first and container:InsertBefore(created, first) or container:AppendChild(created)
			added:SetClass("toast", true)
			added.inner_rml = '<div class="toast-bar"></div><div class="toast-content">' .. tostring(toast.body or "") .. '</div>'

			active = active + 1
			dew_core.setToastActive(true)

			dew.requestAnimationFrame(function()
				added:SetClass("toast-show", true)
			end)
			dew.setTimeout(function()
				added:SetClass("toast-show", false)
				dew.setTimeout(function()
					container:RemoveChild(added)
					active = active - 1
					if active <= 0 then
						active = 0
						dew_core.setToastActive(false)
					end
				end, 3000)
			end, 3000)
		end

		dew.on("toast", function(message)
			show(message.data or {})
		end)
	</script>
</head>
<body>
	<div id="toast_container"></div>
</body>
</rml>

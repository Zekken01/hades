<rml>
<head>
	<title>Voting</title>
	<link type="text/rcss" href="dew://lib/html.rcss"/>
	<link type="text/rcss" href="dew://lib/window-resize.rcss"/>
	<link type="text/rcss" href="voting.rcss"/>
	<script src="dew://lib/jq.lua"></script>
	<script src="voting.lua"></script>
</head>
<body>
	<div id="container">
		<div class="page_content">
			<div class="window-compact">
				<div class="left">
					<button id="showButton"><img class="button" src="dew://assets/buttons/360_Y.png"/><span>Show</span></button>
				</div>
				<div class="compact-timer" id="timerCompact"></div>
			</div>
			<div id="window" style="display: none;">
				<div class="top">
					<div id="votingDesc">Voting round ends in: <span id="timer"></span></div>
					<div class="rule" id="votingDescRule"></div>
					<div id="votingOptions">
						<div class="vetoBox">
							<a id="vetoBox" class="veto-flash" onclick="veto()">
								<img class="vetoBoxBtn button"/><img id="vetoedX" class="button" src="vetoed.png"/>
								<span id="vetoText">Veto Map and Game</span>
							</a>
						</div>
					</div>
					<div class="vetoCountBox">
						<div class="rule rule-static"></div>
						<div id="vetoCountDown">VETO COUNTDOWN: <span id="vetoTimer"></span></div>
						<div id="vetoCount">Vetoes: <span id="voteCount"></span></div>
					</div>
					<div class="rule rule-static" id="vetoStatusRule"></div>
					<div id="vetoStatus"></div>
					<div id="vetoMapInfo"></div>
				</div>
				<div class="bottomBar">
					<div class="rule rule-top"></div>
					<button id="scoreboardButton" style="display: none;"><img class="button"/>Prior Game Stats</button>
					<button id="vetoButton"><img class="button"/>Veto</button>
					<button id="closeButton"><img class="button"/>Close</button>
					<div class="rule rule-bottom"></div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>

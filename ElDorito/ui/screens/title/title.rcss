/* Port of screens/title/title.css (unscaled page: vh units as in the web UI; vmin = vh on landscape screens) */

body {
	cursor: default;
	font-family: "Conduit ITC";
}

#TitleScreen {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.background {
	position: absolute;
	left: 0;
	top: 0;
	margin: 0;
	width: 100%;
	height: 100%;
}

.eldorito {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	height: 20%;
}

.teamlogo {
	position: absolute;
	margin: 0;
	bottom: 3%;
	right: 3%;
	width: 30vh;
	opacity: 0.9;
}

.instructionText {
	position: absolute;
	bottom: 24%;
	left: 0;
	width: 100%;
	text-align: center;
	color: white;
	font-size: 3vh;
	z-index: 2;
	opacity: 0.8;
	line-height: 3vh;
}

.title {
	position: absolute;
	bottom: 3%;
	left: 0;
	width: 100%;
	box-sizing: border-box;
	color: white;
	font-size: 2vh;
	z-index: 2;
	opacity: 0.5;
	padding-left: 3%;
}

.legend {
	position: absolute;
	width: 32vh;
	height: 14vh;
	top: 3%;
	left: 1%;
	opacity: 0.75;
}

.legend img {
	height: 4vh;
}

#navigate {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	box-sizing: border-box;
	text-align: left;
	font-size: 3vh;
	color: white;
	padding-left: 8%;
}

#up { position: absolute; left: 20%; top: 28.5%; }
#down { position: absolute; left: 20%; top: 55%; }
#left { position: absolute; left: 8%; top: 55%; }
#right { position: absolute; left: 32%; top: 55%; }
#enter { position: absolute; left: 50%; top: 40%; }
#mouse { position: absolute; left: 90%; top: 33%; height: 5.5vh; }
#esc { position: absolute; left: 70%; top: 40%; }

#dpad {
	display: none;
	position: absolute;
	left: 20%;
	top: 35%;
	height: 5vh;
}

#announcementBG {
	display: none;
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: #000000b3;
	z-index: 9;
}

#announcementBox {
	z-index: 10;
	display: none;
	position: absolute;
	top: 20vh;
	left: 0;
	width: 100%;
	height: 55vh;
}

#announcementBox .link {
	color: #95bde1;
	cursor: pointer;
}

.announcement {
	border-top: 1px #6270791a;
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 55vh;
	background-color: #14234a;
	decorator: image(dew://assets/announcements/welcome_01.jpg cover);
	box-sizing: border-box;
}

.announcement p {
	display: block;
	font-effect: shadow(0px 2px #00000029);
	color: #94a4b7;
	font-size: 1.94444vh;
	opacity: 0.75;
	margin: 1em 0;
}

.announcement p.announceTitle {
	color: #f0f0f0;
	font-size: 7.5vh;
	opacity: 1;
	padding-left: 16.66667vh;
	width: 53vh;
}

.announcement p.announcesubTitle {
	color: #f0f0f0;
	font-size: 4.44444vh;
	padding-left: 0;
}

img#closeAnnounceButton {
	width: 3.33333vh;
	margin-top: 0.41667vh;
}

#announcementBox #buttonNav {
	position: absolute;
	top: 55vh;
	left: 0;
	height: 4.44444vh;
	width: 100%;
	background-color: black;
	color: white;
	box-sizing: border-box;
	padding-left: 16.66667vh;
}

#buttonNav .navlabel {
	font-size: 2.8vh;
	color: #f0f0f0;
	padding-left: 0.3vh;
	position: absolute;
	padding-top: 0.4vh;
	cursor: pointer;
}

.navlabel:hover, .link:hover {
	text-decoration: underline;
}

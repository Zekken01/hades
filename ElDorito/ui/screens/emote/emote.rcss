/*
 * Port of screens/emote/emote.css.  The wheel's slices are generated SVG (inline <svg>
 * content, re-rasterised when the selection changes); the icons are <img>s on top, since
 * the SVG renderer cannot load external images.  The colours come from the game in Lua.
 */

body {
	font-family: "Conduit ITC";
}

#emote-widget-container {
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.emote-wheel {
	width: 270dp;
	height: 270dp;
	position: absolute;
	left: 505dp;
	top: 225dp;
}

/* viewBox -3 -3 506 506 keeps the 2px border strokes on the edge inside the raster */
#wheelSvg {
	display: block;
	position: absolute;
	left: -1.62dp;
	top: -1.62dp;
	width: 273.24dp;
	height: 273.24dp;
}

#wheelIcons {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#wheelIcons img {
	position: absolute;
}

.emote-grid {
	width: 570dp;
	height: 570dp;
	position: absolute;
	left: 355dp;
	top: 75dp;
}

#emoteGridCells {
	position: absolute;
}

.emote-cell {
	position: absolute;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	text-align: center;
	border-width: 1dp;
	z-index: 0;
}

.emote-cell.selected {
	z-index: 1;
}

.emote-icon {
	pointer-events: none;
}

/* .scale-up: transform scale(0) -> scale(1), 0.3s ease, kept */
.emote-wheel, .emote-grid {
	transform: scale(0);
}
.emote-wheel.grow, .emote-grid.grow {
	transform: scale(1);
	transition: transform 0.3s cubic-in-out;
}

/* Port of screens/server_settings/settings.css: the settings page styles (shared
   settings.rcss) with one page, no tabs, and text inputs. */

.page {
	top: 6.48vh;
	height: 65vh;
}

.backgroundFill {
	top: 0;
	height: 100%;
}

.buttonContainer {
	padding-bottom: 0;
}

.tinySetting {
	width: 7.5vh;
}

.setting.textInput {
	background-color: #00000033;
	text-transform: none;
	font-weight: 300;
	line-height: 2.5vh;
}

input.setting.textInput {
	height: 2.5vh;
	padding-top: 0;
	padding-bottom: 0;
}

textarea.setting {
	height: 7vh;
}

.row.tall {
	height: 7vh;
}

/* the page's own settings.css differs from the settings screen's here */
.row {
	padding-top: 0.44vh;
	min-height: 3.11vh;
	margin-bottom: 0.4vh;
}

/* rows holding a sub header: the h3 starts at the top of the row */
.row.subRow {
	min-height: 0;
	margin-bottom: 0;
}

.subHeader {
	box-sizing: content-box;
	height: 4vh;
	padding: 0.7vh 0;
}

.rangeSetting {
	padding: 0;
}

/* the range input's own height made these rows 2px taller */
.row.rangeRow {
	min-height: 3.39vh;
}

.hasTiny {
	left: 8vh; /* right: 2vh; width: calc(100% - 10vh) */
}

.show-password-btn {
	cursor: pointer;
	position: absolute;
	top: 3%;
	right: 4vh;
	width: 7vh;
	text-align: center;
}

.show-password-btn:hover {
	color: white;
	text-decoration: underline;
}

#closeButton {
	position: absolute;
	top: 1vh;
	left: 0;
	height: 4vh;
	line-height: 3.9vh;
	font-size: 3vh;
	font-weight: 100;
	color: #D8D8D8;
	background-color: transparent;
	border-width: 0;
	text-align: left;
	padding: 0;
	cursor: pointer;
}

#closeButton img {
	display: block;
	position: relative;
	height: 4vh;
	width: 4vh;
	float: left;
}

#closeButton:hover {
	text-decoration: underline;
	color: white;
}

<rml>
<head>
	<title>ElDewrito Console</title>
	<link type="text/rcss" href="dew://lib/html.rcss"/>
	<link type="text/rcss" href="console.rcss"/>
	<script src="dew://lib/jq.lua"></script>
	<script src="console.lua"></script>
</head>
<body>
	<div class="console" id="console">
		<div class="row" id="row-top">
			<div class="box titlebar" id="titlebar">ElDewrito <span id="version"></span> <span id="memory-usage"></span></div>
			<div class="box buttons top">
				<div id="button-size" class="button">Size</div>
				<div id="button-dock" class="button">Dock</div>
				<div id="button-hide" class="button">Close</div>
			</div>
		</div>
		<div class="box output" id="output-box">
			<pre class="info">Enter <span class="command"><b>help</b></span> for a list of available commands or <span class="command"><b>variables</b></span> for a list of available variables. Press Escape to close.<br/>Don't forget to use <span class="command">writeconfig</span> to save your changes!</pre>
		</div>
		<div class="row" id="row-bottom">
			<div id="input-box" class="box input">
				<span class="prompt">&gt;&#160;</span>
				<input type="text" class="input" id="command"/>
			</div>
			<div class="box buttons bottom">
				<div id="button-help" class="button">Help</div>
				<div id="button-clear" class="button">Clear</div>
				<div id="button-reset" class="button">Reset</div>
			</div>
		</div>
		<div class="resize-handle" id="resize-handle"></div>
	</div>
</body>
</rml>

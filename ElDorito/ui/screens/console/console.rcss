/*
 * Port of screens/console/console.css.  The calc() widths of the inline-block rows are
 * flex rows here; Console.Invert flips the column order.
 */

body {
	margin: 0;
	padding: 0;
}

.console {
	position: absolute;
	left: 0;
	top: 0;
	box-sizing: border-box;
	width: 100%;
	height: 50%;
	padding: 6px;
	color: white;
	font-family: "Consolas";
	font-size: 13.33px;
	background-color: rgba(20, 31, 55, 191);
	border-radius: 4px;
	min-width: 400px;
	min-height: 300px;
	display: flex;
	flex-direction: column;
}

.console.inverted {
	flex-direction: column-reverse;
}

.row {
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	height: 30px;
	margin-bottom: 5px;
}

.console.inverted .row {
	margin-bottom: 0;
	margin-top: 5px;
}

.console .box {
	border: 1px #2a2d36;
	border-radius: 2px;
}

.console .box.titlebar, .console .box.input {
	flex: 1 1 auto;
	box-sizing: border-box;
	height: 30px;
	padding: 0 4px;
	line-height: 26px;
	margin-right: 10px;
	white-space: nowrap;
	overflow: hidden;
}

.console .box.input {
	display: flex;
	flex-direction: row;
	background-color: rgba(255, 255, 255, 25);
	cursor: text;
}

.console .box.input .prompt {
	width: 15px;
	color: #00bfff;
	flex: 0 0 auto;
}

.console #command {
	flex: 1 1 auto;
	height: 28px;
	line-height: 28px;
	color: white;
	font-family: "Consolas";
	font-size: 13.33px;
	margin: 0;
	padding: 0;
}

.console #command selection {
	background-color: #c0c0c0;
	color: black;
}

.console .box.buttons {
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	height: 30px;
	padding: 0;
	margin-right: -5px;
	border-width: 0;
}

.console .box.buttons .button {
	box-sizing: border-box;
	height: 30px;
	width: 60px;
	padding: 0 8px;
	margin-right: 5px;
	line-height: 28px;
	color: #00bfff;
	text-align: center;
	border: 1px #2a2d36;
	border-radius: 2px;
	cursor: pointer;
}

.console .box.buttons .button:hover {
	color: white;
	border-color: white;
}

.console .box.output {
	flex: 1 1 auto;
	margin-bottom: 5px;
	background-color: rgba(0, 0, 0, 25);
	overflow: auto;
	word-break: break-word;
}

.console.inverted .box.output {
	margin-bottom: 0;
	margin-top: 5px;
}

.console .box scrollbarvertical {
	width: 9px;
}

.console .box scrollbarvertical slidertrack {
	background-color: rgba(255, 255, 255, 13);
	border-left: 1px #202020;
}

.console .box scrollbarvertical sliderbar {
	background-color: rgba(0, 0, 0, 77);
	border-radius: 0;
	min-height: 20px;
}

.console .box:hover scrollbarvertical sliderbar {
	background-color: #202020;
}

.console .box.output pre {
	display: block;
	margin: 0;
	padding: 2px 5px;
	white-space: pre-wrap;
}

.console .box.output pre.info, .console .box.output pre.suggestion {
	padding: 20px;
}

.console .box.output pre.suggestion {
	background-color: rgba(255, 255, 255, 13);
}

.console .box.output pre .command {
	color: #ff9b00;
	cursor: pointer;
}

.console .box.output pre .command:hover, .console .box.output pre .command.selected {
	text-decoration: underline;
}

.console .box.output pre .description {
	color: #ababab;
}

.console .box.output pre.command-line {
	color: #00bfff;
	background-color: rgba(255, 255, 255, 13);
}

.console .box.output pre.debug-line {
	color: #af4444;
}

.console .box.output pre.error-line {
	background-color: #af4444;
}

.console #memory-usage {
	float: right;
}

.resize-handle {
	display: none;
}

.console.undocked .resize-handle {
	display: block;
	position: absolute;
	width: 8px;
	height: 8px;
	bottom: -4px;
	right: -4px;
	background-color: rgb(0, 191, 255);
	border-radius: 4px;
	cursor: resize;
}

<rml>
<head>
	<title>Server Mod Browser</title>
	<link type="text/rcss" href="dew://lib/html.rcss"/>
	<link type="text/rcss" href="dew://screens/mod_browse/mod_browse.rcss"/>
	<link type="text/rcss" href="server_mod_browser.rcss"/>
	<script src="dew://lib/jq.lua"></script>
	<script src="dew://lib/input.lua"></script>
	<script src="server_mod_browser.lua"></script>
</head>
<body>
	<div id="overlay"></div>
	<div id="container">
		<div id="screen_widget" class="screen_widget_select_map">
			<div class="screen_widget_header">
				<div class="screen_widget_title"><span>SERVER MOD BROWSER</span><button id="refresh"></button></div>
			</div>
			<div class="screen_widget_body">
				<div class="screen_widget_row">
					<div class="col1">
						<input type="text" id="searchbox" placeholder="SEARCH..." value=""/>
						<div class="mod_selection_list" id="mod_selection_list"></div>
					</div>
					<div class="mod_details">
						<div class="mod_details_head">
							<h3 class="mod_details_title" id="mod_name"></h3>
						</div>
						<div class="mod_details_body">
							<p class="mod_details_body_desc" id="mod_description"></p>
						</div>
						<div class="mod_details_footer">
							<div class="mod_details_author"><span class="mod_details_attr_label">AUTHOR:</span><span class="mod_details_attr_value" id="mod_author">N/A</span></div>
							<div class="mod_details_size"><span class="mod_details_attr_label">VERSION:</span><span class="mod_details_attr_value" id="mod_version">N/A</span></div>
							<div class="mod_details_size"><span class="mod_details_attr_label">SIZE:</span><span class="mod_details_attr_value" id="mod_filesize">N/A</span></div>
							<div class="mod_details_size"><span class="mod_details_attr_label">WEBSITE:</span><span class="mod_details_attr_value"><a id="mod_website">N/A</a></span></div>
							<div class="mod_details_size"><span class="mod_details_attr_label">SERVER:</span><span class="mod_details_attr_value mod_source" id="mod_source">N/A</span></div>
						</div>
					</div>
				</div>
			</div>
			<div class="screen_widget_footer">
				<div class="button_key">
					<span class="button_key_button" id="button_key_select"><img class="button_icon" src="dew://assets/buttons/360_A.png"/><span>Select</span></span>
					<span class="button_key_button" id="button_key_back"><img class="button_icon" src="dew://assets/buttons/360_B.png"/><span>Back</span></span>
					<span class="button_key_button" id="button_key_refresh"><img class="button_icon" src="dew://assets/buttons/360_X.png"/><span id="refreshLegendLink">Refresh</span></span>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>

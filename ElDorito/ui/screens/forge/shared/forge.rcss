/*
 * Port of screens/forge/shared/css/{forge-shared,window,property-grid,toast}.css.
 * px become dp, rgba() alphas are hex (RCSS rgba alpha is 0-255); ::before/::after lines are real elements (.hline) in the markup; the
 * list hover bars are decorators on the item; ":empty" is a class set from Lua.
 */

body {
	font-size: 16dp;
}

.hidden {
	display: none;
}

.container {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	color: #adadad;
	font-size: 17.6dp;
}

/* ---- window.css */

.window {
	display: flex;
	flex-direction: column;
	overflow: hidden;
	clip: always;
	width: 420dp;
	border-radius: 4dp;
	decorator: linear-gradient(to bottom, #1b2946f2 0%, #182745e6 20%, #182745e6 20%, #061025e6 100%);
}

.window-body {
	position: relative;
	display: flex;
	flex-direction: column;
}

.window-header {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	padding: 0 10dp;
	box-sizing: border-box;
	width: 100%;
	height: 70dp;
	flex-shrink: 0;
	background-color: #00000080;
}

.hline {
	position: absolute;
	left: 0;
	right: 0;
	height: 1dp;
	decorator: linear-gradient(to right, transparent, #ffffff59, transparent);
}
.window-header .hline { bottom: 1dp; }
.window-footer .hline { top: 1dp; }

.window-title {
	text-transform: uppercase;
	font-size: 1.4em;
}

.window-subtitle {
	display: block;
	font-size: 1em;
	vertical-align: text-bottom;
	color: #c8c8c880;
	margin-top: 5dp;
	text-transform: uppercase;
	width: 100%;
}

.window-footer {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 60dp;
	flex-shrink: 0;
	box-sizing: border-box;
	padding: 0 10dp;
	background-color: #00000080;
}

.window-info-box {
	position: relative;
	display: flex;
	align-items: center;
	height: 60dp;
	padding: 10dp 10dp;
	box-sizing: border-box;
	flex-shrink: 0;
	background-color: #00000033;
	color: #77879a;
	overflow: hidden;
	clip: always;
}
.window-info-box .hline {
	top: 1dp;
	decorator: linear-gradient(to right, transparent, #c8c8c84c, transparent);
}

.legend {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
}
.legend.hidden {
	display: none;
}

.legend .legend-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-right: 10dp;
	font-size: 1.2em;
}

.legend .legend-item img {
	height: 26dp;
	width: 26dp;
	margin-right: 4dp;
}

.legend .legend-item a {
	cursor: pointer;
}
.legend .legend-item a:hover {
	text-decoration: underline;
}

/* ---- property-grid.css */

.property-grid {
	width: 100%;
	overflow-y: auto;
	display: block;
	max-height: 470dp;
}

.property-grid .item {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	padding: 10dp 0 10dp 10dp;
	height: 38dp;
	box-sizing: border-box;
	font-size: 1.1em;
	text-transform: uppercase;
}

.property-grid .heading {
	height: 28dp;
	display: flex;
	align-items: center;
	justify-content: center;
	text-transform: uppercase;
	font-size: 1em;
	vertical-align: text-bottom;
	background-color: #0000004c;
}

.property-grid .item.selected {
	color: #cccccc;
	decorator: svg(dew://assets/ux/buttonhover.svg);
}

.property-grid .item .label {
	margin-right: auto;
}

.property-grid .item .item-editor {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	max-width: 270dp;
	min-width: 200dp;
	padding-right: 10dp;
}

.property-grid input.range {
	width: 110dp;
	height: 21dp;
	margin: 0;
}
.property-grid input.range slidertrack {
	height: 6dp;
	margin-top: 7.5dp;
	background-color: #00000080;
	border-radius: 1.3dp;
}
.property-grid input.range sliderprogress {
	height: 0;
}
.property-grid input.range sliderbar {
	width: 12dp;
	height: 21dp;
	border: 1dp #000000;
	background-color: #5f5f5f;
}

.property-grid .item input.text {
	width: 60dp;
	margin-right: 5dp;
	text-align: center;
	color: #adadad;
}
.property-grid .item.selected input.text {
	color: #cccccc;
}

.property-grid .item select {
	min-width: 150dp;
	width: 150dp;
	padding: 6dp 0;
	text-transform: uppercase;
	text-align: center;
	color: #adadad;
}
.property-grid .item.selected select {
	color: #cccccc;
}
.property-grid .item select selectarrow {
	width: 0;
	height: 0;
}
.property-grid .item select selectbox {
	background-color: #ffffff;
	color: #000000;
	text-align: left;
	max-height: 300dp;
	overflow-y: auto;
}
.property-grid .item select selectbox option {
	padding: 5dp;
}
.property-grid .item select selectbox option:hover,
.property-grid .item select selectbox option:checked {
	background-color: #1e90ff;
	color: #ffffff;
}

.property-grid .item .color-preview {
	width: 28dp;
	height: 24dp;
}

.property-grid scrollbarvertical,
.tree scrollbarvertical,
.category-tree scrollbarvertical,
.item-list scrollbarvertical,
.prefab-list scrollbarvertical,
.material-list scrollbarvertical,
.flag-list scrollbarvertical {
	width: 10dp;
}
.property-grid scrollbarvertical slidertrack,
.tree scrollbarvertical slidertrack,
.category-tree scrollbarvertical slidertrack,
.item-list scrollbarvertical slidertrack,
.prefab-list scrollbarvertical slidertrack,
.material-list scrollbarvertical slidertrack,
.flag-list scrollbarvertical slidertrack {
	background-color: transparent;
}
.property-grid scrollbarvertical sliderbar,
.tree scrollbarvertical sliderbar,
.category-tree scrollbarvertical sliderbar,
.item-list scrollbarvertical sliderbar,
.prefab-list scrollbarvertical sliderbar,
.material-list scrollbarvertical sliderbar,
.flag-list scrollbarvertical sliderbar {
	background-color: grey;
	border-radius: 0;
}

/* ---- toast.css */

.toast-container {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	padding-top: 40dp;
	pointer-events: none;
}

.toast {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: center;
	overflow: hidden;
	clip: always;
	width: 300dp;
	border-radius: 4dp;
	padding: 25dp;
	font-size: 1.25em;
	margin-bottom: 10dp;
	transform: translateX(-600dp);
	transition: transform 0.3s quadratic-in-out;
}

.toast.info {
	background-color: #061324e6;
}

.toast.toast-show {
	transform: translateX(0dp);
}

.toast .toast-bar {
	position: absolute;
	right: 0;
	top: 0;
	height: 100%;
	width: 100%;
	background-color: #449ed133;
	transition: width 0.42s cubic-in-out;
}

.toast.toast-show .toast-bar {
	width: 10dp;
}

.toast-content {
	opacity: 0;
	color: #cfcfcf;
	transition: opacity 0.32s quadratic-in;
}

.toast.toast-show .toast-content {
	opacity: 1;
}

/* forge-shared.css reset every element (all: unset), so the colour picker's hex input inherits
   the "HEX:" label font here instead of Chromium's form-control font. */
.ed-color-picker__detail_hex-input {
	font-family: "Conduit ITC";
	font-size: 1em;
	vertical-align: text-bottom;
}

/*
 * Port of screens/profile_settings/customization.css with the grid layout of
 * style-global-window.css worked out in dp: the tab page is 3/5 of the 1088dp content
 * (652.8dp: button list 341.4dp | 32dp | side list 279.4dp), the player window the rest.
 * The canvas nameplate tinting is image-color (it cannot brighten past the source).
 */

#background {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -100;
}

#blackLayer {
	display: none;
}

/* customization.css #background_left & co. RCSS has no calc(): the original's
   width: calc(50vw - 88.8vh) is a box in the left half of the screen that stops 640dp (half
   the page) short of its right side; the header, footer and tab gradient were centred boxes
   whose right edges land 88.8vh and 81.8vh left of the screen's centre. */
#leftFiller {
	position: absolute;
	left: 0;
	top: 0;
	width: 50%;
	height: 100%;
	z-index: -101;
	overflow: hidden;
}
#background_left_box {
	position: absolute;
	left: 0;
	top: 0;
	right: 640dp;
	height: 100%;
}
#background_left {
	display: block;
	width: 100%;
	height: 100%;
}
/* the page's own .header and .bottomBar gradients, so the bands run on unbroken into the
   strip (the original's own gradients here, 58.17%-119% and 19%--140.71%, left a step at
   the page edge) */
#background_left_header {
	position: absolute;
	right: 640dp;
	top: 0;
	width: 89vh;
	height: 13.3vh;
	decorator: linear-gradient(to bottom, #00000000 76%, #00000066 140%);
}
#background_left_footer {
	position: absolute;
	right: 640dp;
	bottom: 0;
	width: 89vh;
	height: 10vh;
	decorator: linear-gradient(to top, #00000000 20%, #00000066 140%);
}
/* the inset box-shadow is left out (no box-shadow in RCSS) */
#tab-gradient {
	position: absolute;
	right: 81.8vh;
	top: 13.3vh;
	width: 11vh;
	height: 6.1vh;
	background-color: #00000040;
	transform: skewX(-45deg);
}

.tabpage-container {
	position: relative;
	float: left;
	width: 100%;
	height: 508dp;
	box-sizing: border-box;
}

.tabpage {
	position: absolute;
	left: 96dp;
	top: 0;
	width: 652.8dp;
	height: 508dp;
}
.tabpage.hide {
	display: none;
}

#playerWindow {
	position: absolute;
	right: 96dp;
	top: 0;
	width: 435.2dp;
	height: 508dp;
}

.buttonContainer {
	position: absolute;
	left: 0;
	top: 30dp;
	width: 341.4dp;
	height: 284dp;
	overflow-y: auto;
	padding-bottom: 10dp;
	box-sizing: border-box;
}

.buttonContainer .row {
	display: block;
}

.button-list label {
	cursor: pointer;
}

.infoBox {
	position: absolute;
	left: 0;
	top: 314dp;
	width: 341.4dp;
	height: 130dp;
	padding-top: 40dp;
	padding-bottom: 0;
}
.infoBox.hide {
	display: none;
}

.side-list {
	position: absolute;
	left: 373.4dp;
	top: 0;
	width: 259.4dp;
	height: 440dp;
	padding: 34dp 10dp;
}

/* ---- armor tiles */

/* the original's .armorForm img is 251x141 whatever the list width (with or without a
   scrollbar), and the tile shrinks to it */
.armorForm span.tile {
	box-sizing: content-box;
	width: 251dp;
	height: 141dp;
}
.armorForm img {
	width: 251dp;
	height: 141dp;
}
/* customization.css: img:not([src]) { visibility: hidden }.  RmlUi draws an image without
   a texture as a plain white quad. */
img:not([src]) {
	visibility: hidden;
}
/* the chosen/selected ring is a box-shadow outside the tile in the original: put the
   border outside the image and take it back out of the layout */
.armorForm span.tile.selectedElement, .armorForm span.tile.chosenElement {
	margin: -3dp -3dp 5dp -3dp;
}
.armorForm label, .emblemForm label {
	position: absolute;
	left: 0;
	bottom: 0;
	padding: 12dp;
	font-size: 21dp;
	text-transform: uppercase;
	color: #EBEBEB;
	z-index: 1;
}

/* ---- color grids (grid-template-columns: repeat(3, 1fr); gap 6px) */

.colorForm {
	display: block;
	width: 100%;
}
.colorForm.hide {
	display: none;
}
.colorForm span.tile {
	float: left;
	width: 82dp;
	height: 30dp;
	margin: 0 6dp 6dp 0;
}
.colorForm span.tile.third {
	margin-right: 0;
}
.colorForm span.customColor {
	width: 258dp;
	height: 34dp;
	margin-right: 0;
	font-size: 18dp;
	line-height: 22dp;
	text-align: center;
	text-transform: uppercase;
	color: #A5BEDB;
	padding: 6dp;
}
.customColor .hex {
	display: none;
}
.customColor:hover .caption, .customColor.selectedElement .caption {
	display: none;
}
.customColor:hover .hex, .customColor.selectedElement .hex {
	display: inline;
}

/* ---- emblem tiles */

.emblem-tile span.tile {
	height: 63dp;
}
.emblem-tile img {
	position: absolute;
	right: 5dp;
	top: 0;
	height: 63dp;
	width: 63dp;
}
/* customization.css: the image is 185px wide at its own proportions (405x124 art: 185x56.64)
   and the tile is as tall as the image */
.nameplate-tile span.tile {
	height: 56.64dp;
}
.nameplate-tile img {
	position: absolute;
	right: 5dp;
	top: 0;
	width: 185dp;
	height: 56.64dp;
}
/* deliberate change from the original (12px off the bottom): the name is centred on the
   tile's height, level with the logo */
.nameplate-tile label {
	padding-top: 0;
	padding-bottom: 0;
	line-height: 56.64dp;
}
/* the ring is a box-shadow outside the tile in the original (see .armorForm span.tile) */
.nameplate-tile span.tile.selectedElement, .nameplate-tile span.tile.chosenElement {
	box-sizing: content-box;
	margin: -3dp -3dp 5dp -3dp;
}

.pickerHost.hide {
	display: none;
}

/* ---- emblem preview */

.emblemBox {
	position: absolute;
	left: 0;
	top: 314dp;
	width: 341.4dp;
	height: 140dp;
}
.emblemPreviewBig {
	position: absolute;
	left: 30%;
	top: -40dp;
	width: 130dp;
	height: 130dp;
}
#playerNamePlate {
	position: absolute;
	left: 30%;
	margin-left: -85dp;
	top: 110dp;
	width: 300dp;
	height: 36dp;
}
#nameplateBase, #nameplateBaseTray {
	position: absolute;
	left: -15dp;
	top: 0;
	height: 36dp;
	width: 330dp;
}
#nameplateBaseTray {
	image-color: #0000008c;
}
#nameplateEmblem {
	position: absolute;
	left: -10dp;
	top: 2dp;
	width: 31dp;
	height: 31dp;
}
#playerNamePlateName {
	position: absolute;
	left: 26dp;
	top: 1.5dp;
	color: white;
	font-size: 26dp;
	letter-spacing: -1dp;
	font-effect: outline(1px black);
}
#nameplatePreview {
	position: absolute;
	right: 45dp;
	top: 0;
	height: 36dp;
	width: 160dp;
}

/* ---- bottom bar */

.bottomBar .legend-button img {
	display: none;
}
#settingsWindow.gamepad .legend-button img, #settingsWindow.gamepad .tabs img {
	display: block;
}

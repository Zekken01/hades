/*
 * Browser-like defaults for the RML screens.  RmlUi has no user-agent stylesheet: every
 * element is inline until styled, so each screen links this file first.
 */

body {
	font-family: "Conduit ITC";
	font-size: 16px;
	color: #ffffff;
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

div, p, h1, h2, h3, h4, h5, h6, ul, ol, li, header, footer, section, article, nav, main, aside, form, fieldset, label.block, hr, pre {
	display: block;
}

p, ul, ol { margin: 0; }
h1 { font-size: 2em; font-weight: bold; }
h2 { font-size: 1.5em; font-weight: bold; }
h3 { font-size: 1.17em; font-weight: bold; }
h4 { font-size: 1em; font-weight: bold; }
h5 { font-size: 0.83em; font-weight: bold; }
h6 { font-size: 0.67em; font-weight: bold; }

b, strong { font-weight: bold; }
i, em { font-style: italic; }
span, a, label, small, code, img { display: inline; }
small { font-size: 0.8em; }
pre { white-space: pre; }
hr { height: 1dp; background-color: #ffffff33; margin: 6dp 0; }
li { display: block; }
a { cursor: pointer; }

/* the browser default border-spacing: 2px (between the cells and around them) */
table { display: table; box-sizing: border-box; gap: 2dp; padding: 2dp; }
tr { display: table-row; box-sizing: border-box; }
td, th { display: table-cell; box-sizing: border-box; padding: 1dp; } /* UA default padding */
th { font-weight: bold; text-align: center; }
thead, tbody, tfoot { display: table-row-group; }
col { display: table-column; }
colgroup { display: table-column-group; }

input, select, textarea, button { display: inline-block; box-sizing: border-box; }
button { cursor: pointer; text-align: center; }
textarea { white-space: pre-wrap; }
input.text, input.password, textarea { cursor: text; }

/* <select> internals */
/* one line, clipped, like the browser's select (a long audio device name wrapped onto the next row);
   options stay on one line and the open list grows to the longest one */
select selectvalue { display: block; white-space: nowrap; overflow: hidden; }
select selectbox { width: auto; min-width: 100%; }
select selectbox option { white-space: nowrap; }
/* the open list is a popup: above later rows (z-index) and never cut by a scrolling page (clip) */
select selectbox { background-color: #0a1724f2; z-index: 1000; clip: none; }
select selectbox option { display: block; padding: 2dp 6dp; }
select selectbox option:hover, select selectbox option:checked { background-color: #2b6390; }

/* checkbox / radio */
input.checkbox, input.radio { width: 16dp; height: 16dp; border: 1dp #ffffff88; }
input.checkbox:checked, input.radio:checked { background-color: #449ed1; }

/* range */
input.range { height: 16dp; }
input.range slidertrack { height: 4dp; margin-top: 6dp; background-color: #ffffff33; }
input.range sliderprogress { height: 4dp; margin-top: 6dp; background-color: #449ed1; }
input.range sliderbar { width: 10dp; height: 16dp; background-color: #ffffff; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }

/* scrollbars (replaces ::-webkit-scrollbar) */
scrollbarvertical { width: 6dp; }
scrollbarvertical slidertrack { background-color: #ffffff10; }
scrollbarvertical sliderbar { background-color: #ffffff55; min-height: 20dp; border-radius: 3dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal { height: 6dp; }
scrollbarhorizontal slidertrack { background-color: #ffffff10; }
scrollbarhorizontal sliderbar { background-color: #ffffff55; min-width: 20dp; border-radius: 3dp; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }

/* helpers used by the ported scripts */
.hidden { display: none; }
.fade-hidden { opacity: 0; }

/* CSS line-height: normal (the browser default the screens were written against).  RCSS has no
   "normal" and defaults to 1.2; for Conduit ITC Chromium on Windows uses the OS/2 win metrics:
   (917 + 236) / 1000. */
body { line-height: 1.153; }

<rml>
<head>
	<style>
		body { width: 100%; height: 100%; }
		div { display: block; }
		#t { position: absolute; left: 100px; top: 100px; width: 200px; height: 200px; background-color: #ff0000; opacity: 0; transition: opacity 0.3s linear-in-out; }
		#t.on { opacity: 1; }
		@keyframes grow { from { width: 10px; } to { width: 400px; } }
		#k { position: absolute; left: 100px; top: 400px; height: 50px; width: 10px; background-color: #00ff00; animation: 0.3s linear-in-out grow; }
	</style>
	<script>
		dew_core.setTimer(nil, function() document:GetElementById("t"):SetClass("on", true) end, 100, false)
	</script>
</head>
<body><div id="t"></div><div id="k"></div></body>
</rml>

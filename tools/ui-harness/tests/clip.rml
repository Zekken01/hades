<rml>
<head>
	<style>
		body { width: 100%; height: 100%; } div { display: block; }
		#e { position: absolute; left: 50px; top: 50px; width: 300px; height: 100px; overflow: hidden; border-radius: 30px; background-color: #00ffff; }
		#e div { width: 600px; height: 50px; background-color: #ff8800; }
	</style>
</head>
<body><div id="e"><div></div></div></body>
</rml>

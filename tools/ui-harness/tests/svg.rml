<rml>
<head>
	<style>
		body { width: 100%; height: 100%; }
		div { display: block; }
		svg { display: inline-block; }
		#ranks svg { width: 60px; height: 70px; margin: 4px; }
		#medals svg { width: 64px; height: 64px; margin: 4px; }
		#hover { position: absolute; left: 40px; top: 560px; width: 435px; height: 28px; decorator: svg(dew://assets/ux/buttonhover.svg); }
	</style>
</head>
<body>
	<div id="ranks">
		<svg src="dew://assets/ranks/0.svg"/><svg src="dew://assets/ranks/5.svg"/><svg src="dew://assets/ranks/10.svg"/><svg src="dew://assets/ranks/20.svg"/><svg src="dew://assets/ranks/30.svg"/><svg src="dew://assets/ranks/40.svg"/><svg src="dew://assets/ranks/42.svg"/>
	</div>
	<div id="medals">
		<svg src="dew://assets/medals/assassin.svg"/><svg src="dew://assets/medals/doublekill.svg"/><svg src="dew://assets/medals/killingspree.svg"/>
	</div>
	<div id="hover"></div>
</body>
</rml>
